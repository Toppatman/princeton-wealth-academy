
---
const menuItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about/' },
  { label: 'Education', href: '/education/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Events', href: '/events/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Contact', href: '/contact/' },
];

const normalizePath = (path: string) =>
  path.replace(/\/+$/, '') || '/';

const currentPath = normalizePath(Astro.url.pathname);

const isCurrent = (href: string) =>
  normalizePath(href) === currentPath;
---

<header class="site-header">
  <div class="brand">
    <a href="/">Princeton Wealth Academy</a>
  </div>

  <!-- Desktop navigation -->
  <nav class="desktop-nav" aria-label="Main navigation">
    <ul class="nav-links">
      {menuItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Mobile hamburger button -->
  <button
    id="menu-button"
    class="menu-button"
    type="button"
    aria-label="Open navigation menu"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <span aria-hidden="true">☰</span>
  </button>
</header>

<!-- Mobile slide-out sidebar -->
<dialog
  id="mobile-menu"
  class="mobile-drawer"
  aria-label="Mobile navigation menu"
>
  <div class="drawer-header">
    <strong>Menu</strong>

    <button
      id="close-button"
      class="close-button"
      type="button"
      aria-label="Close navigation menu"
    >
      <span aria-hidden="true">×</span>
    </button>
  </div>

  <nav aria-label="Mobile navigation">
    <ul class="mobile-links">
      {menuItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>(
    '#mobile-menu'
  );

  const menuButton = document.querySelector<HTMLButtonElement>(
    '#menu-button'
  );

  const closeButton = document.querySelector<HTMLButtonElement>(
    '#close-button'
  );

  menuButton?.addEventListener('click', () => {
    menu?.showModal();
    menuButton.setAttribute('aria-expanded', 'true');
    document.body.classList.add('mobile-nav-open');
  });

  closeButton?.addEventListener('click', () => {
    menu?.close();
  });

  menu?.addEventListener('close', () => {
    menuButton?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('mobile-nav-open');
  });

  // Close when clicking outside the sidebar.
  menu?.addEventListener('click', (event) => {
    if (event.target === menu) {
      menu.close();
    }
  });
</script>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #d9dfe5;
    background: var(--warm-white);
  }

  .brand {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .brand a {
    color: var(--navy);
    text-decoration: none;
  }

  /* Desktop navigation */

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    color: var(--navy);
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  /* Hamburger button */

  .menu-button {
    display: none;
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: var(--navy);
    font-size: 1.8rem;
    cursor: pointer;
    padding: 0.35rem 0.6rem;
  }

  /* Mobile sidebar */

  .mobile-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    width: min(320px, 85vw);
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 1.5rem;
    border: none;
    background: var(--warm-white);
    color: var(--navy);
    box-shadow: -8px 0 30px rgb(0 0 0 / 15%);
  }

  .mobile-drawer::backdrop {
    background: rgb(0 0 0 / 50%);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #d9dfe5;
  }

  .close-button {
    background: transparent;
    border: none;
    color: var(--navy);
    font-size: 2rem;
    cursor: pointer;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .mobile-links a {
    display: block;
    padding: 0.75rem;
    color: var(--navy);
    text-decoration: none;
    border-radius: 6px;
  }

  .mobile-links a:hover {
    background: var(--light-blue);
  }

  .mobile-links a[aria-current='page'] {
    border-left: 3px solid var(--gold);
    background: var(--light-blue);
    font-weight: 700;
  }

  .menu-button:focus-visible,
  .close-button:focus-visible,
  .nav-links a:focus-visible,
  .mobile-links a:focus-visible,
  .brand a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  /* Switch to mobile navigation */

  @media (max-width: 950px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 380px) {
    .brand {
      font-size: 1rem;
    }
  }
</style>
