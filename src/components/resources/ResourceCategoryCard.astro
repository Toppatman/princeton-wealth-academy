---
import {
  resourceCategoryUrl,
  resourceCopy,
  type ResourceCategory,
  type ResourceLocale,
} from '../../data/resources';

interface Props {
  category: ResourceCategory;
  locale: ResourceLocale;
}

const { category, locale } = Astro.props;
const copy = resourceCopy[locale];
---

<a class="resource-category-card" href={resourceCategoryUrl(locale, category.slug)}>
  <span class="resource-category-card__icon" aria-hidden="true">{category.icon}</span>
  <h3>{category.title[locale]}</h3>
  <p>{category.description[locale]}</p>
  <span class="resource-category-card__action">
    {copy.viewCategory}<span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .resource-category-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 235px;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid #dce5ee;
    border-top: 4px solid var(--gold, #d4a853);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 5px 24px rgba(11, 45, 91, 0.055);
    color: var(--navy, #0b2d5b);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .resource-category-card:hover {
    transform: translateY(-3px);
    border-color: #c2d3e4;
    border-top-color: var(--gold, #d4a853);
    box-shadow: 0 14px 36px rgba(11, 45, 91, 0.11);
  }

  .resource-category-card:focus-visible {
    outline: 3px solid var(--sky-blue, #4f8cc9);
    outline-offset: 4px;
  }

  .resource-category-card__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 20px;
    border-radius: 12px;
    background: #eef4fa;
    font-size: 1.6rem;
    line-height: 1;
  }

  h3 {
    margin: 0 0 10px;
    color: var(--navy, #0b2d5b);
    font: 700 clamp(1.2rem, 2vw, 1.4rem) / 1.25 Georgia, serif;
  }

  p {
    margin: 0 0 25px;
    color: #4e6073;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .resource-category-card__action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    color: var(--navy, #0b2d5b);
    font-size: 0.91rem;
    font-weight: 700;
  }

  .resource-category-card__action span {
    font-size: 1.2rem;
    transition: transform 150ms ease;
  }

  .resource-category-card:hover .resource-category-card__action span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-category-card,
    .resource-category-card__action span { transition: none; }
  }
</style>
