---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceItemCard from './ResourceItemCard.astro';
import { resourceEntries } from '../../data/resourceEntries';
import {
  resourceCopy,
  resourcesHome,
  type ResourceCategory,
  type ResourceLocale,
} from '../../data/resources';

interface Props {
  locale: ResourceLocale;
  category: ResourceCategory;
}

const { locale, category } = Astro.props;
const copy = resourceCopy[locale];
const entries = resourceEntries.filter(
  (entry) => entry.category === category.slug && entry.locale === locale,
);
---

<BaseLayout
  title={category.title[locale]}
  description={category.description[locale]}
>
  <div class="resource-detail">
    <nav class="resource-breadcrumbs" aria-label={locale === 'zh' ? '面包屑导航' : 'Breadcrumb'}>
      <a href={resourcesHome(locale)}>{copy.breadcrumb}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.title[locale]}</span>
    </nav>

    <header class="resource-detail__header">
      <p class="resource-detail__eyebrow">{copy.categoryEyebrow}</p>
      <div class="resource-detail__icon" aria-hidden="true">{category.icon}</div>
      <h1>{category.title[locale]}</h1>
      <p>{category.description[locale]}</p>
    </header>

    <section class="resource-detail__materials" aria-labelledby="resource-materials-title">
      <h2 id="resource-materials-title">{copy.materialsHeading}</h2>
      {entries.length > 0 ? (
        <div class="resource-entry-grid">
          {entries.map((entry) => (
            <ResourceItemCard resource={entry} locale={locale} />
          ))}
        </div>
      ) : (
        <div class="resource-empty">
          <h3>{copy.emptyTitle}</h3>
          <p>{copy.emptyText}</p>
        </div>
      )}
    </section>

    <a class="resource-detail__back" href={resourcesHome(locale)}>
      <span aria-hidden="true">←</span> {copy.back}
    </a>
  </div>
</BaseLayout>

<style>
  .resource-detail { max-width: 1100px; margin: 0 auto; padding: 16px 0 44px; }
  .resource-breadcrumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 0 36px; color: #53667a; font-size: 0.94rem; }
  .resource-breadcrumbs a { color: var(--navy, #0b2d5b); text-underline-offset: 3px; }
  .resource-detail__header { padding: 44px clamp(24px, 5vw, 58px); border-radius: 16px; background: #edf4fa; }
  .resource-detail__eyebrow { margin: 0 0 16px; color: #315d86; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; }
  .resource-detail__icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 16px; border-radius: 12px; background: white; font-size: 1.6rem; }
  .resource-detail__header h1 { margin: 0 0 14px; color: #0b2d5b; font: 700 clamp(2.2rem, 4.8vw, 3.6rem)/1.13 Georgia, serif; }
  .resource-detail__header > p:last-child { max-width: 660px; margin: 0; color: #405b74; font-size: 1.07rem; line-height: 1.75; }
  .resource-detail__materials { padding: 42px 0 30px; }
  .resource-detail__materials h2 { margin: 0 0 22px; color: var(--navy, #0b2d5b); font: 700 1.75rem/1.25 Georgia, serif; }
  .resource-entry-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .resource-empty { padding: 32px; border: 1px dashed #b3c8dc; border-radius: 12px; background: #fff; }
  .resource-empty h3 { margin: 0 0 8px; color: #0b2d5b; font: 700 1.22rem/1.35 Georgia, serif; }
  .resource-empty p { margin: 0; color: #52677b; line-height: 1.7; }
  .resource-detail__back { display: inline-flex; align-items: center; gap: 9px; margin-top: 8px; color: var(--navy, #0b2d5b); font-weight: 700; text-underline-offset: 4px; }
  .resource-detail a:focus-visible { outline: 3px solid var(--sky-blue, #4f8cc9); outline-offset: 4px; }
  @media (max-width: 650px) {
    .resource-breadcrumbs { margin-bottom: 22px; }
    .resource-detail__header { padding: 32px 24px; }
    .resource-entry-grid { grid-template-columns: 1fr; }
    .resource-empty { padding: 24px; }
  }
</style>
