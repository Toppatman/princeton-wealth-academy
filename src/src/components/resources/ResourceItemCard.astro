---
import type { ResourceEntry } from '../../data/resourceEntries';
import { resourceCopy, type ResourceLocale } from '../../data/resources';

interface Props {
  resource: ResourceEntry;
  locale: ResourceLocale;
}

const { resource, locale } = Astro.props;
const copy = resourceCopy[locale];
---

<article class="resource-item">
  <span class="resource-item__format">{resource.format}</span>
  <h3>{resource.title}</h3>
  <p>{resource.description}</p>
  <a
    href={resource.href}
    target={resource.external ? '_blank' : undefined}
    rel={resource.external ? 'noopener noreferrer' : undefined}
  >
    {copy.openResource} <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .resource-item {
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 26px;
    background: white;
    border: 1px solid #dce5ee;
    border-radius: 12px;
  }
  .resource-item__format {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
    background: #eef4fa;
    color: #31557b;
    font-size: 0.76rem;
    font-weight: 700;
  }
  h3 { margin: 14px 0 9px; color: var(--navy, #0b2d5b); font: 700 1.2rem/1.35 Georgia, serif; }
  p { margin: 0 0 18px; color: #4e6073; line-height: 1.65; }
  a { margin-top: auto; font-weight: 700; color: var(--navy, #0b2d5b); }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline: 3px solid var(--sky-blue, #4f8cc9); outline-offset: 4px; }
</style>
