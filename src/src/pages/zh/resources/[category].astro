---
import ResourcesCategoryPage from '../../../components/resources/ResourcesCategoryPage.astro';
import { resourceCategories } from '../../../data/resources';

export function getStaticPaths() {
  return resourceCategories.map((category) => ({
    params: { category: category.slug },
    props: { categoryData: category },
  }));
}

const { categoryData } = Astro.props;
---

<ResourcesCategoryPage locale="zh" category={categoryData} />
