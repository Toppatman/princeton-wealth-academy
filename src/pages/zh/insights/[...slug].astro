---
import { getCollection, render } from 'astro:content';
import ArticleLayout from "../../../layouts/ArticleLayout.astro";


export async function getStaticPaths() {
  const articles = await getCollection('insights');

  return articles
    .filter((article) => article.id.startsWith('zh/'))
    .map((article) => ({
    params: { slug: article.id.slice('zh/'.length) },
    props: {
      article,
      related: articles
        .filter((other) => other.id.startsWith('zh/') && article.data.relatedArticles.includes(other.id))
        .map((other) => ({
          title: other.data.title,
          url: `/zh/insights/${other.id.slice('zh/'.length)}/`,
        })),
    },
  }));
}

const { article, related } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout
  lang="zh"
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  author={article.data.author}
  published={article.data.published}
  updated={article.data.updated}
  references={article.data.references}
  relatedArticles={related}
>
  <Content />
</ArticleLayout>
