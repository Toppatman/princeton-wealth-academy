---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('insights')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Insights"
  description="Browse educational articles and insights from Princeton Wealth Academy."
>
  <section class="insights-index" aria-labelledby="insights-heading">
    <div class="page-heading">
      <p class="eyebrow">Princeton Wealth Academy</p>
      <h1 id="insights-heading">Insights</h1>
      <p>Explore our educational articles on financial topics.</p>
    </div>

    <div class="article-grid">
      {articles.map((article) => (
        <article class="article-card">
          <p class="article-category">{article.data.category}</p>
          <h2><a href={`/insights/${article.id}/`}>{article.data.title}</a></h2>
          <p>{article.data.description}</p>
          <p class="date">Published {formatDate(article.data.published)}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .insights-index { padding: 2rem 0 4rem; }
  .page-heading { max-width: 720px; margin-bottom: 2.5rem; }
  .eyebrow, .article-category { text-transform: uppercase; letter-spacing: .08em; color: #936519; font-size: .83rem; font-weight: 700; }
  h1 { font-family: Georgia, serif; font-size: clamp(2.3rem, 5vw, 3.5rem); color: #13385c; margin: .4rem 0 1rem; }
  .page-heading > p:last-child { font-size: 1.08rem; line-height: 1.7; color: #4c5c6a; }
  .article-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  .article-card { background: #fff; border: 1px solid #d8dfe7; border-radius: 10px; padding: 1.6rem; box-shadow: 0 4px 18px rgba(0, 0, 0, .035); }
  .article-card h2 { font-family: Georgia, serif; font-size: 1.5rem; line-height: 1.3; margin: .5rem 0; }
  .article-card h2 a { color: #13385c; text-decoration: none; }
  .article-card h2 a:hover, .article-card h2 a:focus-visible { color: #9a6a13; text-decoration: underline; }
  .article-card > p { line-height: 1.65; }
  .article-card .date { color: #5d6a77; font-size: .9rem; margin-top: 1.3rem; }
</style>
